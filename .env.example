# Keep this file public; place real values only in .env.local.
APP_MODE=demo
NEXT_PUBLIC_APP_MODE=demo
APP_URL=http://localhost:3000

# Neon Postgres. Use the pooled URL at runtime and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DEFAULT_ORGANIZATION_SLUG=northstar-ventures
INGESTION_API_KEY=

# Clerk authentication. Configure both values before setting APP_MODE=production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
ADMIN_EMAILS=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Separately deployed Python inference service.
ML_SERVICE_URL=
ML_SERVICE_API_KEY=

# Protect operational endpoints and multi-instance Server Actions.
CRON_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
